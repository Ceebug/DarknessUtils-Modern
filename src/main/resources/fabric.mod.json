{
  "schemaVersion": 1,
  "id": "darknessutils",
  "version": "${version}",
  "name": "DarknessUtils Modern",
  "description": "Client-side quality-of-life utilities for Minecraft, including automation, slot locking, boss highlighting, and an in-game configuration screen.",
  "authors": [
    "DersWasTaken",
    "Ceebug"
  ],
  "contact": {
    "sources": "https://github.com/Ceebug/DarknessUtils-Modern"
  },
  "license": "GPL-3.0",
  "icon": "assets/darknessutils/logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.ders.darknessutils.DarknessUtils"
    ]
  },
  "mixins": [
    "darknessutils.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": ">=26.3.159"
  }
}
